[Unit]
Description=bismillah under cage on tty1
After=systemd-user-sessions.service systemd-logind.service systemd-tmpfiles-setup.service
After=bismillah-helper.socket
Wants=bismillah-helper.socket
RequiresMountsFor=/home/writer
Conflicts=getty@tty1.service
# The display the firmware booted on. Debian's kernel has no simpledrm, so until the
# real driver binds there is no DRM device at all (docs/spikes/os-gpu-display.md).
Wants=dev-dri-boot\x2dvga.device
After=dev-dri-boot\x2dvga.device

[Service]
User=writer
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=null
StandardError=null
UtmpIdentifier=tty1
TTYReset=yes
TTYVHangup=yes
Environment=XDG_SESSION_TYPE=wayland
# Only the boot display: on a hybrid the other GPU stays closed and can power down.
# WebKit's render device isn't pinned (pinning it broke rendering in the GPU spike).
Environment=WLR_DRM_DEVICES=/dev/dri/boot-vga
# The app starts before home is unlocked, so everything that would write under home
# by XDG (WebKit's data, GTK, fontconfig and Mesa caches) goes to RAM. The app keeps
# its own files at fixed places in home (src-tauri/src/appliance.rs).
Environment=XDG_CACHE_HOME=/run/user/1000/cache
Environment=XDG_CONFIG_HOME=/run/user/1000/config
Environment=XDG_DATA_HOME=/run/user/1000/data
Environment=XDG_STATE_HOME=/run/user/1000/state
# cage reads its layouts only at start: the helper writes them from home's LUKS2
# header (or setup's choice) before each start (docs/spikes/os-keyboard.md).
ExecStartPre=+/usr/libexec/bismillah-helper keyboard-env
EnvironmentFile=-/run/bismillah/keyboard.env
ExecStart=/usr/bin/cage -d -- /usr/bin/bismillah --appliance
# If the app or cage ends, the session starts again (exit 76: new keyboard layouts).
Restart=always
RestartSec=0

[Install]
WantedBy=graphical.target
