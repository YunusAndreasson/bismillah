[Unit]
Description=bismillah helper: the stick's home partition, unlock and keyboard
Requires=bismillah-helper.socket
After=bismillah-helper.socket

[Service]
# Root: it formats, opens and mounts the home partition (crates/bismillah-appliance).
ExecStart=/usr/libexec/bismillah-helper
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# No PrivateNetwork=, ProtectHome= or other namespacing: they give the service its own
# mount namespace, and the home it mounts must be the session's.
