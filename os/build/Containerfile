# Debian 13 build container for bismillah (os/PLAN.md, OS-0 "App on Debian").
# The stick runs trixie's WebKitGTK, so the app is compiled against it here.
# This is the dev machine's build environment, never part of the stick.
# Its inputs are recorded in os/inputs.lock; os/scripts/fetch.sh passes them as
# build arguments and saves the image to os/cache/, so later builds need no network.
ARG CONTAINER_BASE
FROM ${CONTAINER_BASE}

# The same Debian snapshot as the image, so the app links against the WebKitGTK
# the stick ships (trixie-security). Plain HTTP: the base has no CA certificates yet,
# and apt checks the archive signatures itself.
ARG DEBIAN_SNAPSHOT
RUN rm -f /etc/apt/sources.list.d/* \
 && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/$DEBIAN_SNAPSHOT trixie main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/$DEBIAN_SNAPSHOT trixie-security main" \
      > /etc/apt/sources.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git pkg-config xz-utils \
      libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
      librsvg2-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# trixie's rustc is 1.85; the workspace needs >= 1.90 (Cargo.toml rust-version).
# The installers are checked against the hashes in os/inputs.lock before they run:
# this container compiles the helper that runs as root on the stick.
ARG RUST_VERSION
ARG RUSTUP_VERSION
ARG RUSTUP_INIT_SHA256
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/opt/node/bin:$PATH
RUN curl -sSfL -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init" \
 && echo "$RUSTUP_INIT_SHA256  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --profile minimal --default-toolchain "$RUST_VERSION" \
 && rm /tmp/rustup-init

ARG NODE_VERSION
ARG NODE_SHA256
ARG PNPM_VERSION
RUN curl -sSfL -o /tmp/node.tar.xz \
      "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-x64.tar.xz" \
 && echo "$NODE_SHA256  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /opt && rm /tmp/node.tar.xz \
 && mv "/opt/node-v$NODE_VERSION-linux-x64" /opt/node \
 && npm install -g "pnpm@$PNPM_VERSION"

WORKDIR /src
