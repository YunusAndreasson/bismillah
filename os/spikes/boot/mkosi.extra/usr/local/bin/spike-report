#!/bin/sh
# Prints what the signed-boot spike needs to know, to the serial console, then powers off.
exec >/dev/ttyS0 2>&1
echo "SPIKE secureboot: $(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0c-00e098032b8c 2>/dev/null | tr -d ' ')"
echo "SPIKE lockdown: $(cat /sys/kernel/security/lockdown 2>/dev/null)"
echo "SPIKE kernel: $(uname -r)"
echo "SPIKE root: $(findmnt -no SOURCE,FSTYPE,OPTIONS /)"
echo "SPIKE verity: $(veritysetup status root 2>/dev/null | grep -E 'status|mode' | tr -s ' ' | tr '\n' ';')"
dmesg | grep -iE 'secure ?boot|lockdown' | sed 's/^/SPIKE dmesg: /'
systemd-analyze 2>/dev/null | head -1 | sed 's/^/SPIKE time: /'
echo "SPIKE done"
[ -n "${SPIKE_STAY:-}" ] || systemctl poweroff
