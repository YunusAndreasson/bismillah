#!/bin/sh
# Runs inside cage: scales each high-density screen to 2x, then starts the app.
# cage itself always uses scale 1, which makes text tiny on a 4K laptop panel.
# The rule is GNOME's: 2x when the screen has at least 192 dots per inch.
# Screens that report no physical size (VMs, projectors) stay at 1x.

wlr-randr | awk '
  /^[^ ]/ { output = $1 }
  /Physical size:/ { split($3, mm, "x"); width_mm[output] = mm[1] }
  /\(.*current.*\)/ && /px/ { split($1, px, "x"); width_px[output] = px[1] }
  END {
    for (o in width_px)
      if (width_mm[o] > 0 && width_px[o] * 25.4 / width_mm[o] >= 192) print o
  }
' | while read -r output; do
  wlr-randr --output "$output" --scale 2
done

# Exit code 75 asks for the app again inside the same cage (the OS-0 unlock spike's
# restart variant); any other exit ends the session.
while :; do
  "$@"
  status=$?
  [ "$status" = 75 ] || exit "$status"
done
