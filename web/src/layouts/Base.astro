---
import { getImage } from "astro:assets";
import duoRegular from "../assets/fonts/BismillahDuo-Regular.woff2?url";
import notebook from "../assets/stills/22-bismillah.jpg";
import { copy } from "../copy";

interface Props {
  title?: string;
}

const { title = "bismillah" } = Astro.props;

// The link preview: the boy's notebook, the film's poster, which says "writing" even
// as a thumbnail (2026-10-29; until then the tower at night), cropped to the 1.91:1
// that previews use.
const preview = await getImage({
  src: notebook,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const previewUrl = new URL(preview.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#0a0d0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={duoRegular} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* The editor's own typeface (scripts/fonts.sh). A variable font: one file per style
     carries every weight from 400 to 700. */
  @font-face {
    font-family: "Bismillah Duo";
    src: url("../assets/fonts/BismillahDuo-Regular.woff2") format("woff2");
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Bismillah Duo";
    src: url("../assets/fonts/BismillahDuo-Italic.woff2") format("woff2");
    font-weight: 400 700;
    font-style: italic;
    font-display: swap;
  }

  /* The colours of the palette in GUIDELINES.md that the site uses. Each has one place in
     the story, so use it there and nowhere else. The night and the page are the story's
     two worlds, not a theme: the site ignores the system's light or dark preference. */
  :root {
    --night: #0a0d0c;
    --shawl: #56625d;
    --page: #f7f6f2;
    --ink: #1e1e1e;
    --caret: #1e6b4a;

    /* Her shawl, lit: the same grey raised to 4.5:1 or more on every dark ground, for
       small quiet text. The shawl itself (3.07:1 on the night) is for 24px and up. */
    --shawl-light: #72827c;

    /* The editor's own quiet tones on the page (DESIGN.md §9.2), so the page looks as
       the app does: text-secondary (5.66:1) and text-faint (the Basmallah wordmark). */
    --page-secondary: #62625e;
    --page-faint: #9e9d99;

    --font: "Bismillah Duo", ui-monospace, monospace;

    /* Sizes, all of them. The page's size steps with the screen; the rest never move. */
    --size-small: 15px;
    --size-ui: 16px;
    --size-page: 20px;
    --gutter: 16px;
    /* Titles are one step above the writing: the film's, the editor's, the stick's and her
       last line (GUIDELINES.md, Type). */
    --size-title: calc(1.4 * var(--size-page));
    /* One line of writing: the unit of the page's vertical rhythm. */
    --L: calc(1.6 * var(--size-page));

    background: var(--night);
  }

  @media (width <= 640px) {
    :root {
      --size-page: 17px;
    }
  }

  @media (width >= 768px) {
    :root {
      --gutter: 32px;
    }
  }

  @media (width >= 1920px) {
    :root {
      --size-page: 22px;
    }
  }

  body {
    margin: 0;
    color: var(--page);
    font-family: var(--font);
    font-size: var(--size-ui);
    line-height: 1.6;
    font-kerning: normal;
    font-synthesis: none;
    text-size-adjust: 100%;
  }

  /* The two worlds. Each section belongs to one. */
  .night {
    background: var(--night);
    color: var(--page);
    color-scheme: dark;
  }

  /* The page is writing, so it is set at the writing size. */
  .page {
    background: var(--page);
    color: var(--ink);
    color-scheme: light;
    font-size: var(--size-page);
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--page);
    outline-offset: 3px;
  }

  .page :focus-visible {
    outline-color: var(--caret);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* A component that gives an element a `display` would show it while hidden. */
  [hidden] {
    display: none !important;
  }

  /* The editor's caret (DESIGN.md §11): 2px, green, after the last character of a text
     with `data-caret` (her page, and her last line), or, while her page is being written,
     after the last paragraph written so far. It blinks on the app's 1.2 s cycle four
     times once it is in view (site.ts), under WCAG's five seconds, and then rests,
     visible. */
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  [data-caret]:not([data-writing]) .text > :last-child::after,
  [data-caret][data-writing] .text > .end::after {
    content: "";
    display: inline-block;
    inline-size: 2px;
    block-size: 1.15em;
    margin-inline-start: 1px;
    vertical-align: -0.2em;
    background: var(--caret);
  }

  [data-caret][data-awake] .text > :last-child::after {
    animation: caret-blink 1.2s steps(1, end) 4;
  }

  /* Under reduced motion nothing moves or fades: the loops and the push are stills
     (site.ts), and every transition and blink here ends where it would have. */
  @media (prefers-reduced-motion: reduce) {
    *,
    ::before,
    ::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
