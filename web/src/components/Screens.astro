---
// What the editor is, named in one line (the README's), and what it is for, shown rather
// than told, right after her page: one idea to a moment, as an Apple commercial shows it,
// by a plain act of hers or by the app close on her screen (the stick's real screens,
// taken in a VM by os/scripts/shots.ts and laid into the photograph by
// scripts/laptop.py), with its name and its line. The picture holds still while the page
// scrolls, and the next moment fades in (2026-10-29; until then five words under one
// photograph, like tabs). A phone gets each moment square. Without the script they stand
// one under another, each with its line.
import { getImage } from "astro:assets";
import { copy } from "../copy";

// Each moment twice (scripts/laptop.py): the wide strip, and a square for a phone.
const laptops = import.meta.glob<{ default: ImageMetadata }>("../assets/laptop/*.jpg", {
  eager: true,
});
const picture = (name: string) => {
  const found = laptops[`../assets/laptop/${name}.jpg`];
  if (!found) throw new Error(`no src/assets/laptop/${name}.jpg: run scripts/laptop.py`);
  return found.default;
};
const s = copy.screens;
// The editor's text inside the photograph needs a high quality to stay sharp.
const image = (src: ImageMetadata, widths: number[]) =>
  getImage({ src, format: "webp", quality: 88, widths });
const states = await Promise.all(
  s.states.map(async (state) => ({
    ...state,
    laptop: await image(picture(state.picture), [960, 1440, 2160, 3072]),
    crop: await image(picture(`${state.picture}-phone`), [480, 720, 1040]),
  })),
);
---

<section class="screens page" aria-labelledby="screens-heading" data-screens>
  <!-- Her page asks how we will think; this line answers it, and the laptop shows the
       answer. -->
  <h2 id="screens-heading" class="heading title-step">{s.heading}</h2>
  <div class="track" data-track>
    <div class="stage">
      <div class="stack">
        {
          states.map((state, i) => (
            <figure class="state" data-state data-current={i === 0 ? "" : undefined}>
              <picture>
                <source
                  media="(width <= 700px)"
                  type="image/webp"
                  srcset={state.crop.srcSet.attribute}
                  sizes="calc(100vw - 32px)"
                  width={state.crop.attributes.width}
                  height={state.crop.attributes.height}
                />
                <img
                  src={state.laptop.src}
                  srcset={state.laptop.srcSet.attribute}
                  sizes="(min-width: 1440px) 1360px, 100vw"
                  width={state.laptop.attributes.width}
                  height={state.laptop.attributes.height}
                  alt={state.alt}
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="shot"
                />
              </picture>
              <figcaption>
                <span class="name">{state.label}</span>
                {state.line}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <!-- Where the reader is among the screens: one short line for each, the current in
           ink. Only with the script, which changes the screens. -->
      <div class="marks" aria-hidden="true" hidden data-marks>
        {states.map(() => <span data-mark />)}
      </div>
    </div>
  </div>
</section>

<style>
  /* Its last margin stays inside, or the night would show between it and the stick. */
  .screens {
    display: flow-root;
  }

  /* What the editor is, in the titles' size: the answer to her page's question,
     one blank line above the laptop. */
  .heading,
  figcaption {
    max-inline-size: var(--measure);
    padding-inline: var(--gutter);
    text-align: center;
    text-wrap: balance;
  }

  .heading {
    margin: 0 auto var(--L);
    font-weight: 700;
  }

  /* The heading, the laptop, its line and the words fit one window together, so what
     a word changes is seen as it changes. The photograph is 1536:820. */
  .stack {
    max-inline-size: min(1360px, calc((100svh - 16.5rem) * 1.873));
    margin-inline: auto;
  }

  .state {
    margin: 0 0 calc(2 * var(--L));
  }

  .shot {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  figcaption {
    margin: calc(0.5 * var(--L)) auto 0;
    color: var(--page-secondary);
  }

  .name {
    display: block;
    color: var(--ink);
    font-weight: 700;
  }

  /* With the script, the laptop stays on the table while the page scrolls past it, and
     each stretch of scrolling (--step) brings the next screen, with its name and its
     line. The track is that much taller than a window; the stage, a window high,
     holds still inside it. Every state shares one grid cell, so nothing moves but the
     screen. */
  [data-live] .track {
    --step: 50svh;
    block-size: calc(100svh + (var(--n) - 1) * var(--step));
  }

  [data-live] .stage {
    box-sizing: border-box;
    display: grid;
    align-content: center;
    /* Clear of the corner button above. */
    padding-block: 56px var(--gutter);
  }

  /* The laptop, its name and line, and the marks fit the window under the corner
     button. */
  [data-live] .stack {
    display: grid;
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: min(1360px, calc((100svh - 15rem) * 1.873));
  }

  /* The next moment comes in over the last, which stays until it has, so the page's light
     never shows through the picture. */
  [data-live] .state {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transition: opacity 0s linear 600ms;
  }

  [data-live] .state[data-current] {
    z-index: 1;
    opacity: 1;
    transition: opacity 600ms ease;
  }

  /* Its line goes first and the next comes into the quiet, as two lines in one place
     can't be read through each other. */
  [data-live] figcaption {
    opacity: 0;
    transition: opacity 200ms ease;
  }

  [data-live] [data-current] figcaption {
    opacity: 1;
    transition: opacity 400ms ease 200ms;
  }

  /* The marks: a short line for each screen, the current one in ink. */
  .marks {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-block-start: calc(0.5 * var(--L));
  }

  .marks span {
    inline-size: 24px;
    block-size: 2px;
    background: var(--page-faint);
    transition: background-color 600ms ease;
  }

  .marks span[data-current] {
    background: var(--ink);
  }

  /* A phone gets each moment square, no taller than the window leaves room for under
     the corner button and above its line. */
  @media (width <= 700px) {
    .stack {
      padding-inline: var(--gutter);
    }

    [data-live] .shot {
      max-block-size: calc(100svh - 17rem);
      object-fit: cover;
    }
  }
</style>
