---
// The close. How to get the editor first, which comes on a USB stick (Stick.astro),
// straight after what it is, so nothing dark stands between seeing it and getting it.
// Then the page ends on the page: her line, the film's last words, in the editor's
// type with its caret after them, waiting, the visitor's to write after (2026-10-29;
// before that, the boy's notebook, whom the site never introduces). Nothing comes after
// it: no footer.
import Stick from "./Stick.astro";
---

<Stick />

<section class="close page" data-caret>
  <div class="text">
    <p class="mine">These words are mine.</p>
  </div>
</section>

<style>
  .close {
    box-sizing: border-box;
    min-block-size: 70svh;
    display: grid;
    place-content: center;
    padding: calc(3 * var(--L)) var(--gutter);
  }

  /* A title, in ink, as the page's last words, with the editor's caret after them
     (Base.astro), as on her page. */
  .mine {
    margin: 0;
    font-size: var(--size-title);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }
</style>
