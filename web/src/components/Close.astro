---
// The close. How to get the editor first, which comes on a USB stick (Stick.astro),
// straight after what it is, so nothing dark stands between seeing it and getting it; then
// what that leaves open (Questions.astro). Then the page ends on the page: her line, the
// film's last words, in the editor's type with its caret after them. Nothing comes after
// it: no footer.
import Questions from "./Questions.astro";
import Stick from "./Stick.astro";
---

<Stick />
<Questions />

<section class="close page" data-caret>
  <div class="text">
    <p class="mine title-step">These words are mine.</p>
  </div>
</section>

<style>
  .close {
    padding: 0 var(--gutter) calc(6 * var(--L));
  }

  /* The column the stick and the questions start in. */
  .text {
    max-inline-size: var(--column);
    margin-inline: auto;
  }

  /* A title, in ink, as her last words, with the editor's caret after them (Base.astro). */
  .mine {
    margin: 0;
    text-wrap: balance;
  }
</style>
