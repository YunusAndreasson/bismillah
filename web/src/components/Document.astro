---
// A document on the page, set exactly as the editor sets one in its default profile
// (DESIGN.md §8, §11): the Basmallah opening, Bismillah Duo at the writing size with a
// 1.6 line height, the 66ch measure, and the heading scale of §8.4. With the script,
// Zuhd mode follows the reader: the paragraph at the typewriter line (42% from the top)
// is in ink, the rest in text-secondary. A document that is `written` is written as it
// is read, in the editor's typewriter mode: the page holds still while the visitor
// scrolls, each stretch of scrolling writes the next line or sentence at the typewriter
// line, with the caret (Base.astro) after it, and the lines above it rise, as they do in
// the app. Scrolling back takes them back. With an `offer`, the machine offers to finish
// one line, as it does in the film, and she writes on without it (site.ts). Without the
// script, or under reduced motion, all of it is there, and no offer.
import Basmallah from "./Basmallah.astro";

interface Props {
  /** Ends the document with the editor's caret, where the writer stopped. */
  caret?: boolean;
  /** Writes the document as it is read, one line or sentence at a time. */
  written?: boolean;
  /** Where in a written document the machine offers to finish the line, and with what. */
  offer?: { after: string; words: string };
}

const { caret = false, written = false, offer } = Astro.props;
---

<article
  class="document page"
  lang="en"
  data-zuhd
  data-caret={caret ? "" : undefined}
  data-written={written ? "" : undefined}
  data-offer-after={offer?.after}
  data-offer-words={offer?.words}
>
  <div class="stage">
    <div class="sheet">
      <Basmallah />
      <div class="text">
        <slot />
      </div>
    </div>
  </div>
</article>

<style>
  .document {
    padding-inline: var(--gutter);
  }

  .sheet {
    max-inline-size: 66ch;
    margin-inline: auto;
    padding-block: var(--L) calc(3 * var(--L));
    font-variant-ligatures: common-ligatures contextual;
  }

  /* A blank line between paragraphs, as Markdown writes them. */
  .text :global(:where(p, ul, ol, blockquote)) {
    margin-block: 0 var(--L);
    text-wrap: pretty;
  }

  .text :global(:where(h1, h2, h3)) {
    margin-block: 0 var(--L);
    line-height: 1.3em;
    font-weight: 700;
  }

  .text :global(h1) {
    font-size: 1.4em;
    margin-block-start: calc(2 * var(--L));
  }

  .text :global(h2) {
    font-size: 1.22em;
    margin-block-start: calc(1.5 * var(--L));
  }

  .text :global(h3) {
    font-size: 1.08em;
    margin-block-start: calc(1.25 * var(--L));
  }

  /* The first line of a document has no blank line above it. */
  .text > :global(:first-child) {
    margin-block-start: var(--L);
  }

  .text > :global(p:first-child) {
    margin-block-start: 0;
  }

  /* Zuhd mode (§11.1), once the script has marked the current paragraph. */
  [data-zuhd-on] .text > :global(*) {
    color: var(--page-secondary);
    transition: color 200ms ease-out;
  }

  [data-zuhd-on] .text > :global(.current) {
    color: var(--ink);
  }

  /* A heading's Markdown mark, hanging in the margin in text-secondary, as the editor
     shows it while the caret is on the heading's line, and only then; only where the
     margin has room for it (the 66ch sheet and the gutters fit from about 860px), as
     on a phone it would be cut off or push the heading aside. */
  @media (width >= 880px) {
    [data-caret][data-writing] .text > :global(:is(h1, h2, h3).end)::before {
      --mark: 2ch;
      display: inline-block;
      inline-size: var(--mark);
      margin-inline-start: calc(-1 * var(--mark));
      color: var(--page-secondary);
    }

    [data-caret][data-writing] .text > :global(h1.end)::before {
      content: "#";
    }

    [data-caret][data-writing] .text > :global(h2.end)::before {
      --mark: 3ch;
      content: "##";
    }

    [data-caret][data-writing] .text > :global(h3.end)::before {
      --mark: 4ch;
      content: "###";
    }
  }

  /* Written as it is read. The page holds still, a window high, and the sheet moves so the
     line being written stays on the typewriter line. It starts under her screen, unseen,
     and arrives when the light of her screen has become the page, so nothing slides and
     nothing is blank. */
  [data-live].document {
    position: relative;
    block-size: calc(100svh + var(--beats) * 28svh);
    margin-block-start: -100svh;
    padding-inline: 0;
    background: none;
    pointer-events: none;
  }

  [data-live][data-arrived].document {
    pointer-events: auto;
  }

  [data-live] .stage {
    position: sticky;
    inset-block-start: 0;
    box-sizing: border-box;
    block-size: 100svh;
    padding-inline: var(--gutter);
    overflow: clip;
  }

  [data-live][data-arrived] .stage {
    background: var(--page);
  }

  /* On a phone her lines reach the corner button, so as they rise they go under a strip of
     the page, as under an editor's bar, and never rest behind its words. */
  @media (width <= 700px) {
    [data-live][data-arrived] .stage::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      z-index: 1;
      block-size: 56px;
      background: var(--page);
    }
  }

  [data-live] .sheet {
    position: relative;
    padding-block: 0;
    opacity: 0;
    transition:
      transform 600ms ease-out,
      opacity 600ms ease-out;
    will-change: transform;
  }

  [data-live][data-arrived] .sheet {
    opacity: 1;
  }

  /* A line not yet written is not there to see, though a screen reader still reads it, and
     arrives as a line does in the editor, at once but softly. */
  [data-writing] .text :global(.piece) {
    transition: opacity 500ms ease-out;
  }

  [data-writing] .text :global(.piece:not(.written)) {
    opacity: 0;
  }

  /* The machine's offer: the film's own words, in the machine's dark and cold light, cut
     into her line. The one thing on her page that isn't hers; she writes on, and it goes. */
  .text :global(.offer) {
    padding: 0.15em 0.4em;
    background: var(--night);
    color: var(--cold-screen);
    box-decoration-break: clone;
    animation: offer-in 350ms ease-out;
  }

  @keyframes offer-in {
    from {
      opacity: 0;
    }
  }
</style>
