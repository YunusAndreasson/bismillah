---
// A document on the page, set exactly as the editor sets one in its default profile
// (DESIGN.md §8, §11): the Basmallah opening, Bismillah Duo at the writing size with a
// 1.6 line height, the 66ch measure, and the heading scale of §8.4. With the script,
// Zuhd mode follows the reader: the paragraph at the typewriter line (42% from the top)
// is in ink, the rest in text-secondary. A document that is `written` is written as it
// is read: each paragraph arrives when it reaches the typewriter line, where the caret
// (Base.astro) waits after it, and the page below it is empty until then (site.ts).
// Without the script, or under reduced motion, all of it is there.
import Basmallah from "./Basmallah.astro";

interface Props {
  /** Ends the document with the editor's caret, where the writer stopped. */
  caret?: boolean;
  /** Writes the document as it is read, one paragraph at a time. */
  written?: boolean;
}

const { caret = false, written = false } = Astro.props;
---

<article
  class="document page"
  lang="en"
  data-zuhd
  data-caret={caret ? "" : undefined}
  data-written={written ? "" : undefined}
>
  <div class="sheet">
    <Basmallah />
    <div class="text">
      <slot />
    </div>
  </div>
</article>

<style>
  .document {
    padding-inline: var(--gutter);
  }

  .sheet {
    max-inline-size: 66ch;
    margin-inline: auto;
    padding-block: var(--L) calc(3 * var(--L));
    font-variant-ligatures: common-ligatures contextual;
  }

  /* A blank line between paragraphs, as Markdown writes them. */
  .text :global(:where(p, ul, ol, blockquote)) {
    margin-block: 0 var(--L);
  }

  .text :global(:where(h1, h2, h3)) {
    margin-block: 0 var(--L);
    line-height: 1.3em;
    font-weight: 700;
  }

  .text :global(h1) {
    font-size: 1.4em;
    margin-block-start: calc(2 * var(--L));
  }

  .text :global(h2) {
    font-size: 1.22em;
    margin-block-start: calc(1.5 * var(--L));
  }

  .text :global(h3) {
    font-size: 1.08em;
    margin-block-start: calc(1.25 * var(--L));
  }

  /* The first line of a document has no blank line above it. */
  .text > :global(:first-child) {
    margin-block-start: var(--L);
  }

  .text > :global(p:first-child) {
    margin-block-start: 0;
  }

  /* Zuhd mode (§11.1), once the script has marked the current paragraph. */
  [data-zuhd-on] .text > :global(*) {
    color: var(--page-secondary);
    transition: color 200ms ease-out;
  }

  [data-zuhd-on] .text > :global(.current) {
    color: var(--ink);
  }

  /* A heading's Markdown mark, hanging in the margin in text-secondary, as the editor
     shows it while the caret is on the heading's line, and only then; only where the
     margin has room for it (the 66ch sheet and the gutters fit from about 860px), as
     on a phone it would be cut off or push the heading aside. */
  @media (width >= 880px) {
    [data-caret][data-writing] .text > :global(:is(h1, h2, h3).end)::before {
      --mark: 2ch;
      display: inline-block;
      inline-size: var(--mark);
      margin-inline-start: calc(-1 * var(--mark));
      color: var(--page-secondary);
    }

    [data-caret][data-writing] .text > :global(h1.end)::before {
      content: "#";
    }

    [data-caret][data-writing] .text > :global(h2.end)::before {
      --mark: 3ch;
      content: "##";
    }

    [data-caret][data-writing] .text > :global(h3.end)::before {
      --mark: 4ch;
      content: "###";
    }
  }

  /* Written as it is read: a paragraph not yet written is not there to see, though a
     screen reader still reads it, and arrives as a line does in the editor, at once
     but softly. The page below the caret stays empty until the last line is written,
     so what follows never shows before it. */
  [data-writing] .text > :global(*) {
    transition:
      opacity 500ms ease-out,
      color 200ms ease-out;
  }

  [data-writing] .text > :global(:not(.written)) {
    opacity: 0;
  }

  [data-writing] .sheet {
    padding-block-end: calc(58svh - 3 * var(--L));
  }
</style>
