---
// The first screen: a cinema in a dark room. The screen shows the tower at night, the
// film's own first shot, so pressing play starts the film from the picture already
// there. The controls sit below the picture, never on it, so nothing needs a scrim.
import { getImage } from "astro:assets";
import loopNight from "../assets/stills/loop-night.jpg";
import { copy } from "../copy";

const film = "/media/film/cut-v35";
const loop = "/media/loops/v1/night";
const poster = await getImage({ src: loopNight, format: "webp", width: 1600, quality: 82 });
const c = copy.film.controls;
// The loop is motion: under reduced motion no source matches, and the poster stays.
const moving = "(prefers-reduced-motion: no-preference)";
---

<section class="film night" aria-label={copy.film.label}>
  <header class="masthead">
    <h1 class="wordmark">bismillah</h1>
    <p class="what">These words are mine.</p>
    <a class="to-stick" href="#stick">{copy.header.stick}</a>
  </header>

  <figure class="cinema" data-film data-state="idle">
    <figcaption class="caption">
      <span class="kicker">{copy.film.kicker}</span>
      <span class="title">Prompting is not thinking, writing is.</span>
    </figcaption>
    <div class="screen">
      <video
        class="loop"
        muted
        playsinline
        autoplay
        preload="auto"
        poster={poster.src}
        width="1600"
        height="900"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={`${loop}/index.m3u8`} type="application/vnd.apple.mpegurl" media={moving} />
        <source src={`${loop}/av1.mp4`} type='video/mp4; codecs="av01.0.08M.10"' media={moving} />
        <source src={`${loop}/h264.mp4`} type='video/mp4; codecs="avc1.640028"' media={moving} />
      </video>
      <video
        class="feature"
        controls
        playsinline
        preload="none"
        poster={poster.src}
        width="1920"
        height="1080"
        aria-label={copy.film.label}
        data-video
      >
        <source src={`${film}/hls/master.m3u8`} type="application/vnd.apple.mpegurl" />
        <source src={`${film}/film-av1.mp4`} type='video/mp4; codecs="av01.0.08M.10, opus"' />
        <track kind="captions" srclang="en" label={c.captionsTrack} src="/media/captions/cut-v35.en.vtt" />
      </video>
      <!-- The whole picture plays the film; keyboard users have the play button below. -->
      <button class="hit" type="button" tabindex="-1" aria-hidden="true" hidden data-hit>
        <span class="big-play">
          <svg viewBox="0 0 16 16"><path d="M4.5 2.5v11l9-5.5z"></path></svg>
        </span>
      </button>
    </div>

    <div class="controls" role="group" aria-label={c.group} hidden data-controls>
      <button
        class="play"
        type="button"
        aria-label={c.play}
        data-play
        data-label-play={c.play}
        data-label-pause={c.pause}
      >
        <svg class="icon icon-play" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 2.5v11l9-5.5z"></path>
        </svg>
        <svg class="icon icon-pause" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 2.5h2.5v11H4zM9.5 2.5H12v11H9.5z"></path>
        </svg>
      </button>
      <span class="time now" data-now>0:00</span>
      <input
        class="position"
        type="range"
        min="0"
        max="134.9"
        step="0.1"
        value="0"
        aria-label={c.position}
        data-position
      />
      <span class="time total" data-total>2:15</span>
      <button
        class="sound"
        type="button"
        aria-label={c.mute}
        data-mute
        data-label-mute={c.mute}
        data-label-unmute={c.unmute}
      >
        <svg class="icon icon-sound" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 6h3l4-3.5v11L5 10H2z"></path>
          <path class="wave" d="M11 5.5c1.6 1.4 1.6 3.6 0 5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
        </svg>
      </button>
      <button class="full" type="button" aria-label={c.fullscreen} data-full>
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
          <path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10"></path>
        </svg>
      </button>
    </div>
  </figure>

</section>

<style>
  .film {
    /* Everything around the picture: the masthead, the title, the controls and a margin
       below. */
    --chrome: 184px;
    box-sizing: border-box;
    min-block-size: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding-inline: var(--gutter);
    padding-block-end: 16px;
  }

  /* The first screen says what this is before anything plays: the name and its tagline
     (the author, 2026-10-28), the way to get it in the corner, and the film's title. */
  .masthead {
    display: flex;
    /* One line, centred in the bar, with the name and its line on one baseline. */
    flex-wrap: wrap;
    align-content: center;
    align-items: baseline;
    column-gap: 2ch;
    block-size: 56px;
  }

  /* The name at the writing size, a step above its line, so it reads as the name. */
  .wordmark {
    margin: 0;
    font-size: var(--size-page);
    font-weight: 400;
    line-height: 1;
  }

  .what {
    margin: 0;
    color: var(--shawl-light);
    font-size: var(--size-small);
    line-height: 1;
  }

  /* A phone has no room beside the corner button: the line goes under the name. The
     name keeps the corner button's centre line (28px down: 8px, then half of 40px), as
     on a wide screen, and its line starts 8px below the button, whose left end it
     passes under, so the two never touch. */
  @media (width <= 640px) {
    .film {
      /* The taller masthead, and a title on two lines. */
      --chrome: 248px;
    }

    .masthead {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: calc(28px - var(--size-page) / 2);
      box-sizing: border-box;
      padding-block-start: calc(28px - var(--size-page) / 2);
      block-size: 96px;
    }
  }

  /* The way to the editor, always in reach: it starts in the masthead and stays in the
     corner over every scene below. Green means something to press, and it reads on
     both the night and the page. */
  .to-stick {
    position: fixed;
    inset-block-start: 8px;
    inset-inline-end: var(--gutter);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    /* Never over the name: on the narrowest phones the words wrap instead. */
    max-inline-size: calc(100% - 2 * var(--gutter) - 11ch);
    min-block-size: 40px;
    box-sizing: border-box;
    padding: 4px 14px;
    background: var(--caret);
    color: var(--page);
    font-size: var(--size-small);
    line-height: 1.2;
    text-decoration: none;
  }

  /* Beside the name on a 360px phone, the label gives up a pixel and some padding. */
  @media (width <= 400px) {
    .to-stick {
      padding-inline: 10px;
      font-size: calc(var(--size-small) - 1px);
    }
  }

  .to-stick:hover {
    background: color-mix(in srgb, var(--caret) 85%, var(--night));
  }

  /* Where it leads, it isn't needed: it steps aside while the stick is on the screen. */
  .to-stick {
    transition:
      opacity 400ms ease,
      visibility 0s;
  }

  :global(html[data-at-stick]) .to-stick {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 400ms ease,
      visibility 0s 400ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .to-stick,
    :global(html[data-at-stick]) .to-stick {
      transition: none;
    }
  }

  /* A ring of each world, so focus shows over the film and over the page alike. */
  .to-stick:focus-visible {
    outline: 2px solid var(--page);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--night);
  }

  .cinema {
    margin: 0;
    align-self: center;
  }

  /* What the film is and what it says, so a visitor knows before pressing play: a small
     label, then the title at the size of the editor's first heading, in the regular
     weight of the film's own title cards. Without the script it sits above the picture. */
  .caption {
    display: grid;
    justify-items: center;
    gap: 4px;
    inline-size: min(100%, calc((100svh - var(--chrome)) * 16 / 9));
    margin: 0 auto 16px;
    box-sizing: border-box;
    text-align: center;
  }

  .kicker {
    color: var(--shawl-light);
    font-size: var(--size-small);
    line-height: 1.3;
  }

  .title {
    font-size: calc(1.4 * var(--size-page));
    line-height: 1.3;
    text-wrap: balance;
  }

  /* With the script, the caption and the play button are one thing: the label, the
     title and the disc, centred on the picture, on the disc's own translucent night (a
     little deeper, for the lit windows behind). They leave together when the film plays
     and come back when it ends. The layout is there from the first paint (`scripting`),
     so nothing moves when the script arrives; only the caption fades in. */
  @media (scripting: enabled) {
    .film {
      --chrome: 128px;
    }

    .cinema {
      display: grid;
    }

    .caption,
    .screen {
      grid-area: 1 / 1;
    }

    .controls {
      grid-area: 2 / 1;
    }

    .caption {
      z-index: 1;
      place-self: center;
      inline-size: auto;
      max-inline-size: calc(100% - 2 * var(--gutter));
      margin: 0;
      padding: 8px 16px;
      background: color-mix(in srgb, var(--night) 70%, transparent);
      opacity: 0;
      pointer-events: none;
      /* Above the disc: half its own height, the disc's radius, and a gap. */
      translate: 0 calc(-50% - 44px - 20px);
      transition: opacity 400ms ease-out;
    }

    [data-ready][data-state="idle"] .caption,
    [data-ready][data-state="ended"] .caption {
      opacity: 1;
    }
  }

  @media (scripting: enabled) and (width <= 640px) {
    .film {
      --chrome: 168px;
    }

    .caption {
      max-inline-size: 100%;
      translate: 0 calc(-50% - 36px - 16px);
    }
  }

  /* The picture: 16:9, as large as the room allows. */
  .screen {
    position: relative;
    inline-size: min(100%, calc((100svh - var(--chrome)) * 16 / 9));
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    background: var(--night);
    overflow: hidden;
  }

  .screen video,
  .hit {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .loop {
    object-fit: cover;
    /* Her window, at the centre of the tower. */
    object-position: 50% 49%;
  }

  .feature {
    object-fit: contain;
    background: var(--night);
  }

  /* With the script, the loop shows until the film plays, and the film fades in over it. */
  [data-ready] .feature {
    opacity: 0;
    transition: opacity 400ms ease-out;
  }

  [data-ready]:not([data-state="idle"]) .feature {
    opacity: 1;
  }

  .hit {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .hit[hidden] {
    display: none;
  }

  /* So no one misses that this is a film: a large play button at the centre of the
     picture until it plays, and again when it ends. A thin ring on a translucent night,
     so the tower, and her window under it, still show through. */
  .big-play {
    display: grid;
    place-items: center;
    inline-size: 88px;
    block-size: 88px;
    border: 1.5px solid var(--page);
    border-radius: 50%;
    background: color-mix(in srgb, var(--night) 55%, transparent);
    color: var(--page);
    transition:
      opacity 400ms ease-out,
      background-color 180ms ease-out;
  }

  .big-play svg {
    inline-size: 30px;
    block-size: 30px;
    /* The triangle's weight sits left of its box, so nudge it to look centred. */
    margin-inline-start: 4px;
    fill: currentColor;
  }

  .hit:hover .big-play {
    background: color-mix(in srgb, var(--night) 80%, transparent);
  }

  [data-state="playing"] .big-play,
  [data-state="paused"] .big-play {
    opacity: 0;
  }

  @media (width <= 640px) {
    .big-play {
      inline-size: 72px;
      block-size: 72px;
    }

    .big-play svg {
      inline-size: 24px;
      block-size: 24px;
    }
  }

  [data-state="playing"][data-idle] .hit {
    cursor: none;
  }

  /* On an upright phone the tower fills the room, cropped to her window; the film
     itself is always shown whole. */
  @media (aspect-ratio <= 4 / 5) {
    .screen {
      inline-size: 100%;
      aspect-ratio: auto;
      block-size: calc(100svh - var(--chrome));
    }
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    inline-size: min(100%, calc((100svh - var(--chrome)) * 16 / 9));
    block-size: 56px;
    margin-inline: auto;
    color: var(--shawl-light);
    transition: opacity 180ms ease-out;
  }

  .controls[hidden] {
    display: none;
  }

  @media (aspect-ratio <= 4 / 5) {
    .controls {
      inline-size: 100%;
    }
  }

  [data-state="playing"][data-idle] .controls {
    opacity: 0;
    transition-duration: 400ms;
  }

  /* Before the film plays and after it ends, the play button on the picture is the only
     one. The row below waits in its place, unseen, and shows when the keyboard reaches
     it: then only the film's length, ▶ 2:15. */
  [data-state="idle"] .controls:not(:focus-within),
  [data-state="ended"] .controls:not(:focus-within) {
    opacity: 0;
    pointer-events: none;
  }

  [data-state="idle"] .controls > :not(.play, .total) {
    display: none;
  }

  .controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--size-small);
    cursor: pointer;
  }

  .controls button:hover,
  .controls button:focus-visible {
    color: var(--page);
  }

  .play {
    justify-content: flex-start;
  }

  .icon {
    inline-size: 16px;
    block-size: 16px;
    fill: currentColor;
  }

  .icon-pause,
  [data-state="playing"] .icon-play {
    display: none;
  }

  [data-state="playing"] .icon-pause {
    display: block;
  }

  [data-muted] .wave {
    display: none;
  }

  .time {
    font-size: var(--size-ui);
    font-variant-numeric: tabular-nums;
  }

  [data-state="idle"] .total {
    color: var(--page);
  }

  /* The timeline: a hairline, and the editor's green caret for the playhead. */
  .position {
    flex: 1;
    min-inline-size: 0;
    block-size: 44px;
    margin: 0;
    appearance: none;
    background: none;
    cursor: pointer;
  }

  .position::-webkit-slider-runnable-track {
    block-size: 1px;
    background: var(--shawl);
  }

  .position::-moz-range-track {
    block-size: 1px;
    background: var(--shawl);
  }

  .position::-webkit-slider-thumb {
    appearance: none;
    inline-size: 2px;
    block-size: 18px;
    margin-block-start: -8.5px;
    border: 0;
    border-radius: 0;
    background: var(--caret);
  }

  .position::-moz-range-thumb {
    inline-size: 2px;
    block-size: 18px;
    border: 0;
    border-radius: 0;
    background: var(--caret);
  }

  /* Paused, the playhead waits like the caret on a page. */
  [data-state="paused"] .position::-webkit-slider-thumb {
    animation: caret-blink 1.2s steps(1, end) 4;
  }

  [data-state="paused"] .position::-moz-range-thumb {
    animation: caret-blink 1.2s steps(1, end) 4;
  }

  .position:focus-visible {
    outline-offset: -8px;
  }

  @media (width <= 480px) {
    .now {
      display: none;
    }
  }

  /* Full screen: the room is the whole screen, the controls still below the picture. */
  .cinema:fullscreen {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    box-sizing: border-box;
    padding-inline: var(--gutter);
    background: var(--night);
  }

  .cinema:fullscreen .screen,
  .cinema:fullscreen .controls {
    inline-size: min(100%, calc((100svh - 56px) * 16 / 9));
  }

  .cinema:fullscreen .screen {
    aspect-ratio: 16 / 9;
    block-size: auto;
  }

  .cinema:fullscreen .caption {
    display: none;
  }

  video::cue {
    font-family: var(--font);
    color: var(--page);
    background: var(--night);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ready] .feature,
    .controls,
    .caption,
    .big-play {
      transition: none;
    }

    /* Two rules: a selector one engine doesn't know would drop the other's. */
    [data-state="paused"] .position::-webkit-slider-thumb {
      animation: none;
    }

    [data-state="paused"] .position::-moz-range-thumb {
      animation: none;
    }
  }
</style>
