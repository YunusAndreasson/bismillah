---
// Her room and her screen: the film's second and third shots at the visitor's pace. From
// her window in the tower, the camera is in the room: her at the table against the rain
// (still 02). It dissolves to her hands at the laptop (still 03), and scrolling pushes it
// into her screen, whose light becomes the page that follows. Her screen already shows the
// real editor, the Basmallah and "How will we t…", so the page continues it.
//
// Native scrolling, one move at a time. Without the script, or under reduced motion, it
// is one still.
import { Picture } from "astro:assets";
import room from "../assets/stills/02-her-window.jpg";
import still from "../assets/stills/03-her-screen.jpg";

const picture = {
  formats: ["avif", "webp"],
  widths: [640, 960, 1280, 1920],
  sizes: "100vw",
  quality: 80,
  alt: "",
  class: "still",
};
---

<section class="her-screen night" aria-hidden="true" data-push>
  <div class="stage">
    <div class="camera" data-camera>
      <Picture src={still} {...picture} />
      <div class="light" data-light></div>
    </div>
    <div class="camera in-the-room" data-room>
      <Picture src={room} {...picture} />
    </div>
    <div class="veil" data-veil></div>
  </div>
</section>

<style>
  .her-screen {
    position: relative;
  }

  .stage {
    position: relative;
    block-size: min(100svh, 56.25vw);
    overflow: hidden;
  }

  .camera {
    position: absolute;
    inset: 0;
  }

  /* The wide shot of her room comes before it, and only with the script, which moves it. */
  .in-the-room {
    display: none;
    opacity: 0;
  }

  .camera :global(picture),
  .still {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .still {
    object-fit: cover;
    object-position: 74.4% 58.3%;
  }

  /* Her laptop's screen, corner for corner, in the box site.ts gives it. */
  .light {
    clip-path: polygon(11% 0, 100% 5.6%, 93% 100%, 0 82.7%);
  }

  .veil {
    inset: 0;
    pointer-events: none;
  }

  /* The light of her screen, and that light become the page. */
  .light,
  .veil {
    position: absolute;
    background: var(--page);
    opacity: 0;
  }

  /* With the script and motion allowed, the stage holds while the camera moves. It starts
     under the tower's last screen, in the dark, so the shot changes without the page
     sliding. A film that has played has no such shot, and the stage just comes after it. */
  @media (prefers-reduced-motion: no-preference) {
    [data-live].her-screen {
      --travel: 220svh;
      block-size: calc(100svh + var(--travel));
      margin-block-start: -100svh;
    }

    :global(.film[data-seen]) + [data-live].her-screen {
      margin-block-start: 0;
    }

    [data-live] .camera {
      inset: auto;
      will-change: transform;
    }

    [data-live] .in-the-room {
      display: block;
    }
  }
</style>
