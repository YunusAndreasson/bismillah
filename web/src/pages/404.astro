---
import { copy } from "../copy";
import Base from "../layouts/Base.astro";
---

<Base title="Not found · bismillah">
  <main class="night">
    <h1>{copy.notFound}</h1>
    <p><a href="/" data-wordmark>bismillah</a></p>
  </main>
</Base>

<style>
  main {
    box-sizing: border-box;
    min-block-size: 100svh;
    display: grid;
    place-content: center;
    padding: var(--gutter);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: var(--size-page);
    font-weight: 400;
  }

  p {
    margin: 8px 0 0;
    color: var(--shawl-light);
  }
</style>
