---
// The night opens, her page explains, the dawn closes, and the page ends it
// (GUIDELINES.md): the film, her screen, the manifesto, a second document, the close.
import Close from "../components/Close.astro";
import Document from "../components/Document.astro";
import Film from "../components/Film.astro";
import Screen from "../components/Screen.astro";
import { Content as Manifesto } from "../content/manifesto.md";
import { copy } from "../copy";
import Base from "../layouts/Base.astro";
---

<Base>
  <main>
    <Film />
    <Screen />
    <Document caret>
      <Manifesto />
    </Document>
    <Document>
      <p>{copy.editor}</p>
    </Document>
    <Close />
  </main>
</Base>

<script>
  import "../scripts/site.ts";
</script>
