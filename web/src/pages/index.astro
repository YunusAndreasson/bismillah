---
// The night opens, her page (the film's own lines, written as they are read) asks and
// answers, the editor shows itself and how to get it, and the page ends on the page, her
// last line with the caret after it (GUIDELINES.md): the film, her screen, her page,
// the editor's real screens, the close.
import Close from "../components/Close.astro";
import Document from "../components/Document.astro";
import Film from "../components/Film.astro";
import Screen from "../components/Screen.astro";
import Screens from "../components/Screens.astro";
import { Content as HerPage } from "../content/her-page.md";
import { copy } from "../copy";
import Base from "../layouts/Base.astro";
---

<Base title={copy.title}>
  <main>
    <Film />
    <Screen />
    <Document caret written offer={copy.page.offer}>
      <HerPage />
    </Document>
    <Screens />
    <Close />
  </main>
</Base>

<script>
  import "../scripts/site.ts";
</script>
