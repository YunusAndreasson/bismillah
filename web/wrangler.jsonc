{
  "$schema": "node_modules/wrangler/config-schema.json",

  // A static site: no Worker script, only assets. Every request is a file from
  // ./dist, which costs no Worker invocation and has no request-time code to
  // break. Ship with `pnpm ship`, never a bare `wrangler deploy` (AGENTS.md).
  "name": "bismillah",

  // At or before the installed workerd's build date, so `wrangler dev` runs it.
  "compatibility_date": "2026-10-23",

  "assets": {
    "directory": "./dist",
    // Astro writes a real 404.html. This is the static-site mode, NOT
    // "single-page-application", which would answer 200 to every unknown path.
    "not_found_handling": "404-page"
  },

  // The site's own address (bought on Cloudflare, 2026-11-08), and its only one.
  // `wrangler deploy` creates the DNS record and certificate for a custom domain
  // in the account's bismillah.ink zone. workers.dev stays off, because its address
  // is <name>.<account>.workers.dev and names the account; per-version preview URLs
  // stay off too, as each would be another public copy of the site.
  "routes": [{ "pattern": "bismillah.ink", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
