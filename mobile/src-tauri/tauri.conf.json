{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bismillah",
  "identifier": "org.bismillah.reader",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "../node_modules/.bin/vite build --config vite.config.ts"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "bismillah" }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/icon.png"
    ]
  }
}
