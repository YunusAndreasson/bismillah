{
  "name": "bismillah",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "app:build": "tauri build --debug --no-bundle -- --locked",
    "app:mac": "tauri build --debug --bundles app -- --locked",
    "app:shot": "scripts/headless.sh node scripts/app-shot.ts",
    "test:e2e": "scripts/headless.sh wdio run tests/wdio.conf.ts --suite e2e",
    "test:visual": "scripts/headless.sh wdio run tests/wdio.conf.ts --suite visual",
    "test:offline": "scripts/offline.sh",
    "perf": "scripts/headless.sh node scripts/perf.ts",
    "a11y": "BISMILLAH_A11Y=1 scripts/headless.sh node scripts/a11y.ts",
    "verify": "scripts/verify.sh",
    "mobile:dev": "mobile/run.sh dev",
    "mobile:build": "mobile/run.sh build",
    "mobile:show": "mobile/run.sh show",
    "mobile:shot": "mobile/run.sh shot",
    "mobile:test": "mobile/run.sh test",
    "os:fetch": "os/scripts/fetch.sh",
    "os:app": "os/build/build-app.sh",
    "os:build": "os/scripts/build.sh",
    "os:vm": "node os/scripts/vm.ts",
    "os:test": "node os/scripts/test.ts",
    "os:perf": "node os/scripts/perf.ts",
    "os:verify": "os/scripts/verify.sh",
    "os:installer": "os/scripts/installer.sh",
    "os:publish": "node os/scripts/publish.ts",
    "os:shots": "node os/scripts/shots.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "10.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@tauri-apps/api": "2.12.4",
    "bits-ui": "2.20.3"
  }
}
