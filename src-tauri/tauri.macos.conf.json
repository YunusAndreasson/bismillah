{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bismillah",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 360,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown document",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  }
}
